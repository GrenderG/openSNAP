# Copy this file to `.env` and edit values for your local setup.
# This file is organized by service so it is easier to see what each process uses.

# ============================================================================
# Bootstrap Service
# Handles bootstrap auth/login and tells the client which game server to join.
# ============================================================================

# Bind address for the bootstrap UDP socket.
OPENSNAP_BOOTSTRAP_HOST=0.0.0.0

# Host/IP advertised by the bootstrap service when it needs to return its own
# endpoint. Leave empty to derive it from bind host and client routing.
OPENSNAP_BOOTSTRAP_ADVERTISE_HOST=

# UDP port for the bootstrap service.
OPENSNAP_BOOTSTRAP_PORT=9090

# Games whose logins this bootstrap accepts. Every game is identified from its
# login (SN@P title code), and logins from unknown builds are dropped and
# logged. `generic` accepts every known game; a comma-separated list of game
# identifiers (e.g. `monsterhunter` or `automodellista,automodellista_beta1`)
# accepts only those and drops and logs the rest.
OPENSNAP_BOOTSTRAP_GAMES=generic

# Shared bootstrap secret used by the login verifier flow.
OPENSNAP_SERVER_SECRET=Totally secret server secret!

# Shared encryption key used for bootstrap payload encryption/decryption.
OPENSNAP_BOOTSTRAP_KEY=SNAP-SWAN


# ============================================================================
# Game / Lobby Service
# Handles lobby, rooms, and in-game session traffic for one configured game.
# ============================================================================

# Bind address for the game UDP socket.
OPENSNAP_GAME_HOST=0.0.0.0

# Host/IP advertised to clients in bootstrap login-success responses for the
# local game server. Leave empty to derive it from bind host and client routing.
OPENSNAP_GAME_ADVERTISE_HOST=

# UDP port for the game service.
OPENSNAP_GAME_PORT=9091

# Game plugin loaded by the game server process.
OPENSNAP_GAME_PLUGIN=automodellista

# Explicit bootstrap redirect map: game plugin name -> host:port.
# For multi-game deployments, define every game the bootstrap server may route.
# Example:
# {"automodellista":"192.168.1.151:9091","monsterhunter":"192.168.1.152:10070"}
# Object values like `{"host": "...", "port": 1234}` are also accepted.
OPENSNAP_GAME_SERVER_MAP={}

# Shared periodic tick interval used by bootstrap and game services.
OPENSNAP_TICK_INTERVAL_SECONDS=10.0

# Global cap on how many lobbies are exposed/accepted by the game service.
OPENSNAP_MAX_LOBBIES=20

# Maximum number of rooms allowed per lobby.
OPENSNAP_MAX_ROOMS_PER_LOBBY=50

# Global room-cap ceiling. Room creation clamps requested max players to this value.
OPENSNAP_MAX_PLAYERS_PER_ROOM=8

# Root folder for local game data that is not distributed with openSNAP.
# Each plugin reads its own subfolder (for example `data/monsterhunter`).
OPENSNAP_DATA_DIR=data


# ============================================================================
# Plugin-specific configuration
# Settings read only by one game plugin, grouped per plugin. They only take
# effect when OPENSNAP_GAME_PLUGIN selects that plugin.
# ============================================================================

# ----------------------------------------------------------------------------
# Monster Hunter (`monsterhunter` plugin)
# ----------------------------------------------------------------------------

# APP TCP service started by the plugin (Worlds, Lands, Market, Event, quest
# return receipts). Leave the host empty to use OPENSNAP_GAME_HOST.
# Clients expect port 10127.
OPENSNAP_MH_APP_HOST=
OPENSNAP_MH_APP_PORT=10127

# Worlds and their Lands, as World name -> World (1-16 Worlds, listed in this
# order; the name is shown in World Selection, up to 15 characters).
# Without this setting, Brave World below is used. A World has:
# - enabled: false keeps the World configured but unpublished (default true);
# - host: empty for the World served by this server (exactly one World). Any
#   other World runs on another game server (e.g. another region): set its
#   address here; the client logs in to it after choosing that World. Its Lands
#   must match that server's configuration; this server only lists them, and
#   their populations show as 0;
# - description: text shown in the World menu while the World is highlighted, up to
#   255 characters (default "Select a world to login to.");
# - lands: 1-56 Lands (64 in total across Worlds). Each Land has:
#   - key: Area name prefix, up to 13 ASCII characters, unique within its World
#     (Areas are <key>01..<key>NN);
#   - name: display name, shown as "<name> Land", up to 15 characters;
#   - description: text shown in the Land menu while the Land is highlighted, up
#     to 255 characters (default "Select a land to login to.");
#   - areas: number of Areas, 1-26 (also the row count of the Area menu);
#   - capacity: players the Land accepts, 1-65535 (default 750);
#   - color: optional Land menu panel tint, "#RRGGBB" (default "#000000").
# An Area holds at most 63 Towns (3 categories x 21) of
# OPENSNAP_MAX_PLAYERS_PER_ROOM players; the client creates Towns for 8.
#
# Official Land panel colors hardcoded in the JP release (SLPM_654.95
# `netr_sub01_col`, picked by server slot in `Get_ServerColor`; NA receives the
# color from the server instead):
#   slot 0  #FF985D  orange        slot 6  #9BDFF0  cyan
#   slot 1  #73CB8D  green         slot 7  #ED93A4  pink
#   slot 2  #FF5D5D  red           slot 8  #3D3D3D  dark grey
#   slot 3  #96B5FD  blue          slot 9  #EFEFE9  off-white
#   slot 4  #FFD35D  yellow        (10th entry, not reached by the 10-slot
#   slot 5  #B895C6  purple         lookup: #B5B5B5 grey)
OPENSNAP_MH_WORLDS={
  "Brave World": {
    "enabled": true,
    "host": "",
    "description": "Select a world to login to.",
    "lands": [
      {"key": "RED", "name": "Red", "color": "#FF5D5D", "areas": 2, "capacity": 750},
      {"key": "GREEN", "name": "Green", "color": "#73CB8D", "areas": 2, "capacity": 750},
      {"key": "BLUE", "name": "Blue", "color": "#96B5FD", "areas": 2, "capacity": 750}
    ]
  },
  "Sincere World": {
    "enabled": false,
    "host": "sincere.example.com",
    "description": "Select a world to login to.",
    "lands": [
      {"key": "RED", "name": "Red", "color": "#FF5D5D", "areas": 2, "capacity": 750},
      {"key": "GREEN", "name": "Green", "color": "#73CB8D", "areas": 2, "capacity": 750},
      {"key": "BLUE", "name": "Blue", "color": "#96B5FD", "areas": 2, "capacity": 750}
    ]
  }
}


# ============================================================================
# Storage
# Shared state (accounts and bootstrap-to-game session handoffs) used by web,
# bootstrap, and game services. Connection state such as rooms and lobbies stays
# in each server's memory.
# ============================================================================

# Shared store backend: sqlite (default) or mariadb.
# Use mariadb when services run on different machines; it needs the optional
# PyMySQL package (pip install PyMySQL).
OPENSNAP_STORAGE_BACKEND=sqlite

# SQLite database path (sqlite backend). All services must use the same file.
OPENSNAP_SQLITE_PATH=opensnap.db

# MariaDB/MySQL connection (mariadb backend). Keep the database reachable only
# by your own servers (private network/VPN, or TLS plus a firewall allowlist).
OPENSNAP_MARIADB_HOST=
OPENSNAP_MARIADB_PORT=3306
OPENSNAP_MARIADB_USER=
OPENSNAP_MARIADB_PASSWORD=
OPENSNAP_MARIADB_DATABASE=opensnap
# Optional CA certificate file to connect over TLS.
OPENSNAP_MARIADB_SSL_CA=

# Default users inserted in the shared store on startup.
# Format: username:password[:seed[:team]], separated by commas.
OPENSNAP_DEFAULT_USERS=test:1111


# ============================================================================
# Web Service
# Handles registration and web-based account flows.
# ============================================================================

# Bind address for the web server.
OPENSNAP_WEB_HOST=0.0.0.0

# TCP port for the web server.
OPENSNAP_WEB_PORT=80

# Optional HTTPS listener for `rankweb`. Games transitions into
# the web/database flow after post-game lobby leave, and the embedded ranking
# upload URL uses HTTPS. Set both values to enable a local TLS listener.
OPENSNAP_WEB_HTTPS_HOST=0.0.0.0
OPENSNAP_WEB_HTTPS_PORT=443

# NOTE: this built-in listener cannot serve the PS2 clients yet. The Auto
# Modellista browser (RSA SSL-C 2.1) only speaks SSLv3/TLS 1.0 with RC4/3DES
# ciphers (no AES), which modern Python/OpenSSL no longer provide. Terminate
# TLS in Apache, nginx, etc. built against an old OpenSSL (1.0.2) instead,
# proxy to this plain-HTTP web service, and leave both values below blank.
# The client does not verify certificates; a self-signed one valid until
# 2049-12-31 at most (it cannot parse later dates) works.
#
# TLS certificate/key for the optional HTTPS listener. Leave both blank to
# disable HTTPS until local certificates are available.
OPENSNAP_WEB_HTTPS_CERTFILE=
OPENSNAP_WEB_HTTPS_KEYFILE=

# Web route mode/profile:
# - generic (default): register all bundled web modules at once and answer
#   requests from any of those routes.
# - explicit module name (override): register only that one module.
#   Examples: automodellista, automodellista_beta1, monsterhunter.
OPENSNAP_WEB_GAME_PLUGIN=generic


# ============================================================================
# DNS Service
# Provides static DNS answers for bundled game domains.
# ============================================================================

# Bind address for the DNS server.
OPENSNAP_DNS_HOST=0.0.0.0

# UDP port for the DNS server.
OPENSNAP_DNS_PORT=53

# DNS response TTL in seconds.
OPENSNAP_DNS_TTL=60

# Optional fallback IPv4 used by default bundled-module DNS entries.
OPENSNAP_DNS_DEFAULT_IP=

# Static DNS overrides in JSON or Python-dict form.
# Use "@default" to map a name to OPENSNAP_DNS_DEFAULT_IP, then to the game
# server advertise/bind host fallback chain.
OPENSNAP_DNS_ENTRIES={
  # Auto Modellista Beta 1
  "stage.sega.com": "@default",
  "web.ftpublicbeta.games.sega.net": "@default",
  "bootstrap.ftpublicbeta.games.sega.net": "@default",

  # Auto Modellista
  "bootstrap.capcom-am.games.sega.net": "@default",
  "gameweb.capcom-am.games.sega.net": "@default",
  "rankweb.capcom-am.games.sega.net": "@default",
  "regweb.capcom-am.games.sega.net": "@default",

  # Monster Hunter USA
  "regweb.mh.capcom.sf.yav4.com": "@default",
  "bootstrap01.sf.yav4.com": "@default",
  "bootstrap01.mh-beta.capcom.sf.yav4.com": "@default",
  "app01.reo.capcom.sf.yav4.com": "@default",

  # Monster Hunter PAL (and Demo)
  "bootstrap01.mheu-beta.capcom.sf.yav4.com": "@default",

  # Monster Hunter USA Public Beta
  "regweb.reo.capcom.sf.yav4.com": "@default",
  "snap01.reo.capcom.sf.yav4.com": "@default",

  # DNAS gateways (NTSC-U titles: gate1.us, PAL: gate1.eu, NTSC-J: gate1.jp). DNAS itself
  # is not served by openSNAP: these point at this server so a DNAS-compatible
  # service can run on the same IP; use its IPv4 instead if it runs elsewhere.
  "gate1.us.dnas.playstation.org": "@default",
  "gate1.eu.dnas.playstation.org": "@default",
  "gate1.jp.dnas.playstation.org": "@default"}


# ============================================================================
# Logging
# Shared logging configuration for all services.
# ============================================================================

# Console/file log verbosity: debug, info, warn, warning, error, critical.
OPENSNAP_LOG_LEVEL=debug

# Optional directory for persistent logs in addition to stdout.
OPENSNAP_LOG_PATH=

# Max bytes shown in packet hexdumps. Set to 0 for unlimited output.
OPENSNAP_LOG_HEXDUMP_LIMIT=16384
